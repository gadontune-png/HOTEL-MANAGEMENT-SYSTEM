# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hood_hotel?schema=public"

# JWT Authentication (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="change-this-to-a-random-secret"
JWT_REFRESH_SECRET="change-this-to-a-random-refresh-secret"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Redis (optional, for caching)
REDIS_URL="redis://localhost:6379"

# Email (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-password"
SMTP_FROM="noreply@thehoodhotel.com"

# M-Pesa Payment Integration
MPESA_CONSUMER_KEY="your-mpesa-consumer-key"
MPESA_CONSUMER_SECRET="your-mpesa-consumer-secret"
MPESA_PASSKEY="your-mpesa-passkey"
MPESA_SHORTCODE="your-mpesa-shortcode"

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# Rate limiting (max requests per window)
THROTTLE_TTL="60000"
THROTTLE_LIMIT="100"

# S3-compatible storage (optional — set S3_ENABLED=true to use S3 instead of local disk)
S3_ENABLED=false
S3_REGION="us-east-1"
S3_BUCKET="hood-hotel-uploads"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""
